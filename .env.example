# Número de ventas (internacional, solo dígitos). Todos los CTA abren WhatsApp con este número.
NEXT_PUBLIC_WHATSAPP_NUMBER=5493412776893
# URL pública del sitio. Vacía = dominio de producción de Vercel (polisend.vercel.app o el dominio propio que se conecte)
NEXT_PUBLIC_SITE_URL=
# Opcional: token de verificación de Google Search Console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# URL de la API (api_john), sin barra final. La usan el panel (/admin) y la landing, que lee de ahí los planes y precios
# que configura el Owner (GET /public/plans, cache de 1 hora; sin respuesta: el catálogo inicial). En los deploys de
# Vercel sale de .env.production (la API de producción); en local, de .env.local.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Correo para consultas de privacidad y términos. Vacío: solo se muestra el WhatsApp de ventas.
NEXT_PUBLIC_LEGAL_EMAIL=
